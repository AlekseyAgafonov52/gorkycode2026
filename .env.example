# Fill in .env next to question_generator.py.
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

# Use IAM instead of an API key, never both.
# YANDEX_IAM_TOKEN=

# Optional; by default the model is gpt://<YANDEX_FOLDER_ID>/yandexgpt-5.1.
# YANDEX_MODEL_URI=

# PostgreSQL connection URL (required only by the storage layer and Alembic).
# Set your own user, password, host, port and database; keep the real URL in .env.
DATABASE_URL=

# Optional: separate PostgreSQL database for integration tests.
# Tests use an isolated schema in this database.
# TEST_DATABASE_URL=

# Docker Compose: fill POSTGRES_PASSWORD before the first startup.
POSTGRES_DB=hr_platform
POSTGRES_USER=hr_platform
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
# Host port; the PostgreSQL container uses 5432 internally.
POSTGRES_PORT=5433
API_PORT=8000
FRONTEND_PORT=5173

# Telegram department manager bot (optional Docker profile: telegram).
# Token from @BotFather; never commit the real token.
TELEGRAM_BOT_TOKEN=
# Numeric user ID, available via /id in the bot. Empty = no access to HR data.
TELEGRAM_MANAGER_IDS=
# Optional for a local run; Docker keeps the cursor in a named volume.
# TELEGRAM_OFFSET_FILE=.local/telegram_bot/offset.json
